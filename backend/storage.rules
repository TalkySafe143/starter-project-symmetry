rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Article thumbnails — any authenticated user can upload and read.
    match /media/articles/{fileName} {
      allow read: if true;
      allow write: if true;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
